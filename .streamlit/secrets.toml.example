# Copy this file to .streamlit/secrets.toml and fill in the real values.
# Never commit .streamlit/secrets.toml - it is ignored by Git.

# Supabase Postgres. Leave this out to use the local SQLite database instead.
DATABASE_URL = "postgresql://user:password@host:5432/database"

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-random-secret"
client_id = "replace-with-google-client-id"
client_secret = "replace-with-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
